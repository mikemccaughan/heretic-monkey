{
  "name": "heretic-monkey",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve -c dev",
    "buil": "ng build -c dev && cd server && npm run buil",
    "build": "npx npm-check-updates -ux typescript && npm install --force && ng build -c dev && cd server && npm run build",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e"
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/cli": "^22.1.3",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-browser-dynamic": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@hono/node-server": "2.1.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "html2canvas": "^1.4.1",
    "rxjs": "^7.8.2",
    "rxjs-compat": "^6.6.7",
    "vite": "^8.2.0",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@angular/language-service": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "@types/jasmine": "^6.0.0",
    "@types/jasminewd2": "^2.0.13",
    "@types/node": "^26.1.2",
    "angular-eslint": "22.1.0",
    "brace-expansion": "^5.0.9",
    "core-js": "^3.50.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-package-json": "^0.3.0",
    "fast-uri": "^4.1.2",
    "follow-redirects": "^1.16.0",
    "glob": "^13.0.6",
    "hono": "^4.13.0",
    "ip-address": "^10.4.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "^6.3.0",
    "jasmine-spec-reporter": "^7.0.0",
    "js-yaml": "^5.2.3",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-cli": "^2.0.0",
    "karma-coverage-istanbul-reporter": "^3.0.3",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
    "lodash": "^4.18.1",
    "minimatch": "^10.2.6",
    "path-to-regexp": "^8.4.2",
    "picomatch": "^4.0.5",
    "postcss": "^8.5.25",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.66.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.1": true,
    "msgpackr-extract@3.0.4": true,
    "lmdb@3.5.6": true,
    "core-js@3.50.0": true
  },
  "overrides": {
    "@angular/cli": {
      "@modelcontextprovider/sdk": "$@modelcontextprovider/sdk",
      "@hono/node-server": "$@hono/node-server"
    },
    "@modelcontextprovider/sdk": {
      "@hono/node-server": "$@hono/node-server"
    },
    "minimatch": {
      "brace-expansion": "$brace-expansion"
    },
    "karma": {
      "brace-expansion": "$brace-expansion",
      "glob": "$glob",
      "minimatch": "$minimatch",
      "rimraf": "$rimraf"
    },
    "karma-jasmine-html-reporter": {
      "karma": "$karma",
      "brace-expansion": "$brace-expansion",
      "glob": "$glob",
      "minimatch": "$minimatch",
      "rimraf": "$rimraf"
    },
    "karma-coverage-istanbul-reporter": {
      "karma": "$karma",
      "istanbul-lib-source-maps": "$istanbul-lib-instrument",
      "brace-expansion": "$brace-expansion",
      "glob": "$glob",
      "minimatch": "$minimatch",
      "rimraf": "$rimraf"
    },
    "istanbul-lib-source-maps": {
      "brace-expansion": "$brace-expansion",
      "glob": "$glob",
      "minimatch": "$minimatch",
      "rimraf": "$rimraf"
    }
  }
}
